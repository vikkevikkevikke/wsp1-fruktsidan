<h1><%= @category['name'] %></h1>

<ul>

  <% @fruits.each do |fruit| %>

    <li>

      <a href="/fruits/<%= fruit['id'] %>">
        <strong><%= fruit['name'] %></strong>
      </a>

      <a
        href="/fruits/<%= fruit['id'] %>/edit"
        class="edit"
      >
        Ändra
      </a>

      <form
        action="/fruits/<%= fruit['id'] %>/delete"
        method="post"
        class="delete"
      >
        <input
          type="submit"
          value="Ta bort"
        >
      </form>

    </li>

  <% end %>

</ul>

<br>

<a href="/categories">
  Tillbaka till kategorier
</a>