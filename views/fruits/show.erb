<h2>Mer information om vald frukt</h2>

<h2>Mer info om: <%= @fruit['name'] %></h2>

<p>
  Kategori:
  <%= @fruit['category_name'] %>
</p>

<p>
  Smakpoäng:

  <% @fruit["tastiness"].to_i.times do %>
    ★
  <% end %>

  <% (10 - @fruit["tastiness"].to_i).times do %>
    ☆
  <% end %>
</p>

<p>
  Beskrivning:
  <%= @fruit["description"] %>
</p>

<p>
  Ursprungsland:
  <%= @fruit["country"] %>
</p>

<br>

<a href="/fruits">
  Tillbaka till alla frukter
</a>